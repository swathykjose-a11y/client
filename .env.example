# =============================================================================
# Dainty Dazzle - Environment Variables
# Copy this file to .env.local and fill in real values.
# =============================================================================

# --- Backend API (Hono / Node.js) ---
# Server-side only (never exposed via NEXT_PUBLIC)
SERVER_URL=http://localhost:8787
API_URL=http://localhost:8787

# --- Cache Revalidation Secret ---
# Shared secret for on-demand Next.js cache revalidation triggered by Admin / Hono
REVALIDATION_SECRET=your-secret-revalidation-token

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=https://www.daintydazzle.store
